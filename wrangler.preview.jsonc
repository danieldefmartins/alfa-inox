{
  // PREVIEW apenas: https://preview-alfa-inox.<conta>.workers.dev — sem domínio próprio, sem rotas.
  // npm run preview:deploy
  "name": "preview-alfa-inox",
  "main": "worker/site.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
